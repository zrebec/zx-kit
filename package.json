{
  "name": "zx-kit",
  "version": "0.43.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/zrebec/zx-kit.git"
  },
  "description": "A Speccy-flavoured fantasy toolkit for tiny TypeScript browser games",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "zx-spectrum",
    "retro",
    "game",
    "canvas"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "overrides": {
    "npm": ">=11.14.1"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@vitest/coverage-v8": "^4.1.6",
    "jsdom": "^30.0.1",
    "semantic-release": "^25.0.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.5"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
