{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm test -- *)",
      "Bash(npm run test)",
      "Bash(npm run test -- *)",
      "Bash(npm run test:coverage)",
      "Bash(npm run test:coverage -- *)",
      "Bash(npx vitest *)",
      "Bash(npm run build)",
      "Bash(npx tsc)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npm pack --dry-run)",
      "Bash(node -e *)",
      "Bash(node --input-type=module -e *)"
    ],
    "deny": [
      "Bash(npm publish*)",
      "Edit(./CHANGELOG.md)"
    ]
  },
  "attribution": {
    "commit": ""
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/test-on-change.sh\"",
            "statusMessage": "Running tests…",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
