# Normalize all text files to LF in the repo, regardless of contributor OS.
# Git auto-detects text vs binary; text files are stored and checked out with LF.
* text=auto eol=lf

# Explicit text types (belt-and-braces for the files this repo actually ships).
*.ts   text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.html text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Binary assets — never normalize, never diff as text.
# None are tracked today; these are defensive for future loading screens,
# fonts, and chiptune samples that may land in docs/examples.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.mp3  binary
*.wav  binary
*.ogg  binary
